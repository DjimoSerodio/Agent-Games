# LLM API keys for agent simulations
ANTHROPIC_API_KEY=your-anthropic-api-key-here
MINIMAX_API_KEY=your-minimax-token-plan-key-here

# MiniMax experiment runner (optional)
SIM_MAX_ROUNDS=25
# Comma-separated persona file names or paths. Example:
# SIM_PERSONAS=alice-cooperator,bob-strategist,carol-opportunist,dave-builder
SIM_PERSONAS=
# Example: ./tmp/minimax-run.json
SIM_OUTPUT_PATH=

# Game server ports
PORT=3000
ADMIN_PORT=3001

# Database (Phase 2)
DATABASE_URL=postgresql://localhost:5432/coordination_games

# Blockchain (Phase 6)
BASE_RPC_URL=https://sepolia.base.org
BASE_PRIVATE_KEY=your-test-wallet-private-key-here
ERC8004_IDENTITY_REGISTRY=0x0000000000000000000000000000000000000000
EAS_CONTRACT_ADDRESS=0x4200000000000000000000000000000000000021

# Optional: Redis (removed, no longer used)
# REDIS_URL=redis://localhost:6379
